# ===== Majburiy =====
# @BotFather dan olingan token
BOT_TOKEN=
# Bosh adminlar Telegram ID'lari, vergul bilan (ID ni @userinfobot dan bilish mumkin)
ADMIN_IDS=

# ===== Ixtiyoriy =====
# Ma'lumotlar bazasi fayli (standart: data/bot.db)
DB_PATH=
# Redis — bot qayta ishga tushganda ham to'ldirilayotgan formalar yo'qolmasin desangiz (pip install redis)
REDIS_URL=
# Vakansiya necha kundan keyin avtomatik yopiladi
VACANCY_DAYS=30

# ===== Web ilova bilan bog'lanish =====
# Saytning ochiq manzili — menyudagi "🌐 Sayt" tugmasi (https bo'lsa Telegram Mini App sifatida ochiladi)
WEB_URL=
# Web backend manzili (bo'lsa). Bot yangi vakansiya/rezyumelarni shu yerga POST qiladi: {WEB_API_URL}/vacancies, /resumes
WEB_API_URL=
# Ikki tomonlama so'rovlar uchun maxfiy kalit (X-Api-Key sarlavhasi)
WEB_API_KEY=

# Botning o'z REST API serveri (sayt bot bazasidan e'lonlarni o'qishi uchun)
API_ENABLED=0
API_HOST=0.0.0.0
API_PORT=8080
# Qaysi domenlardan so'rov ruxsat etiladi (CORS), masalan https://ayolqadami.uz
API_CORS=*
